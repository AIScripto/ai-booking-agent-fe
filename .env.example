# ─── Frontend build-time config ─────────────────────────────────────────────
# Copy to .env for local development.
#
# NOTE: every VITE_* variable is embedded in the production bundle and is
# visible to every browser that loads the app. Never put a secret here.
#
# Read in exactly one place: src/config/env.ts
# ────────────────────────────────────────────────────────────────────────────

# Base URL for the API.
#   production — leave UNSET. It defaults to the relative path /api/v1, which
#                nginx reverse-proxies to the api container (see nginx.conf).
#                No host or port is baked into the bundle.
#   local dev  — point at your running backend:
VITE_API_BASE_URL="http://localhost:6000/api/v1"

# Development convenience: pre-seeds the active tenant so a tenant-scoped page
# renders without signing in. Leave EMPTY in production — the tenant is
# established at login. An unset tenant surfaces as "please sign in", never as
# a fallback to somebody else's data.
VITE_DEFAULT_TENANT_ID=""
